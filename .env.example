# Copy to .env / .env.local. Do not commit real secrets.

# Supabase (client)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Maps (client — restrict by URL/referrer in the Mapbox dashboard)
VITE_MAPBOX_TOKEN=your_mapbox_token

# Deploy (local only; used by npm run deploy)
DEPLOY_USER=andy
DEPLOY_HOST=web
DEPLOY_DIR=/var/www/dfiu

# --- Supabase Edge Function secrets (set via `supabase secrets set`, not VITE_) ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# VISUAL_CROSSING_KEY=
# SITE_URL=https://dfiu.app
